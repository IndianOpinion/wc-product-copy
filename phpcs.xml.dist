<?xml version="1.0"?>
<ruleset name="wc-product-copy">
    <description>PSR-12 for the plugin and its tests.</description>

    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>wc-product-copy.php</file>
    <file>autoload.php</file>
    <file>uninstall.php</file>

    <!-- The stub layer imitates WordPress function names and several classes per file. -->
    <exclude-pattern>tests/stubs/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- Entry points must run code: they register hooks or load the autoloader. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>wc-product-copy.php</exclude-pattern>
        <exclude-pattern>autoload.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>

    <!-- WordPress callbacks and WP-CLI subcommands use the host's names. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
